{
  "name": "darkroom",
  "version": "0.1.0",
  "description": "A local-first photo library that lives on an external SSD and stays locked until that exact drive is plugged in.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "darkroom": "./src/cli.js"
  },
  "main": "./src/index.js",
  "scripts": {
    "start": "node src/cli.js serve",
    "init": "node src/cli.js init",
    "scan": "node src/cli.js scan",
    "sync": "node src/cli.js sync",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "photos",
    "gallery",
    "self-hosted",
    "local-first",
    "offline",
    "external-drive",
    "archive"
  ],
  "files": [
    "src/",
    "public/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "exifr": "^7.1.3",
    "express": "^4.21.2",
    "sharp": "^0.33.5"
  }
}
